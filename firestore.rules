rules_version = '2';

// FleetPulse — regras de segurança do Firestore
//
// Antes disto, o papel de "admin" era decidido apenas no navegador
// (ADMIN_EMAILS no App.tsx). Qualquer motorista logado podia falar direto
// com a API do Firestore e ler/alterar tudo, ignorando a interface.
// Aqui a regra roda no servidor do Google e não tem como contornar.
//
// Deploy:  firebase deploy --only firestore:rules
// Teste:   Console do Firebase → Firestore → Rules → Playground

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── helpers ─────────

    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() ? request.auth.token.get('email', '') : '';
    }

    function adminByEmail() {
      return email().lower() in [
        'info@dragndrop.us',
        'rogerquerinosilva@gmail.com'
      ];
    }

    // Lê o papel do documento users/{uid}. O custom claim `admin` é checado
    // primeiro porque é mais barato (não faz leitura extra) — se um dia você
    // migrar para custom claims, esta linha já está pronta.
    function adminByDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        adminByEmail() ||
        adminByDoc()
      );
    }

    function isDriver() {
      return signedIn() && !isAdmin();
    }

    // Campos que mudaram numa escrita
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ───────── usuários ─────────
    // Cada um lê o próprio cadastro; ninguém promove a si mesmo a admin.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() ||
        (signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'driver') == 'driver');
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && !changed().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // ───────── caminhões ─────────
    // Motorista precisa ver a frota para escolher o caminhão, e precisa
    // gravar a milhagem ao abastecer — só isso.
    //
    // Nota sobre a milhagem: seria bom a regra exigir que `currentKm` nunca
    // ande para trás, mas o campo está gravado como TEXTO, e a linguagem de
    // regras não converte texto em número — comparar "9000" com "50312" dá o
    // resultado errado, porque a comparação vira alfabética. A checagem
    // continua sendo a da tela do motorista. Para valer no servidor, o caminho
    // é gravar também um `currentKmNumber` numérico; é uma migração e fica
    // para quando você quiser.
    match /trucks/{truckId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isDriver() && changed().hasOnly(['currentKm', 'updatedAt']));
    }

    // ───────── checklists do motorista ─────────
    // O motorista cria o próprio checklist e enxerga os da frota.
    // Aprovar, resolver e apagar é do admin.
    match /driverChecklists/{docId} {
      // Leitura liberada para qualquer usuário autenticado.
      //
      // O motorista precisa ver os problemas em aberto do caminhão que vai
      // dirigir, tenha sido ele quem reportou ou não — senão reporta de novo o
      // que a oficina já sabe. Como o problema pertence ao veículo e não à
      // pessoa, a leitura deixou de ser restrita ao próprio e-mail.
      //
      // O que isso expõe: um motorista consegue ler os checklists dos colegas
      // (nome, e-mail e o que reportaram). Escrever continua fechado: cada um
      // só cria o próprio, e alterar ou apagar é do administrador.
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isDriver() && request.resource.data.driverEmail == email());
      allow update, delete: if isAdmin();
    }

    // ───────── abastecimentos ─────────
    // O motorista registra; conferir e corrigir é do admin.
    //
    // Antes era `allow create: if signedIn()`, sem conferir nada. Dois furos:
    // o motorista podia gravar abastecimento no nome de outro (e aí o registro
    // deixa de valer como prova), e não havia teto nenhum — um laço num script
    // gravava cem mil documentos, que você pagaria no fim do mês.
    //
    // O admin continua livre: ele corrige e importa registro antigo pela tela
    // de Fuel, e não faz sentido amarrar a mão de quem já pode tudo.
    function validFuelRecord() {
      let d = request.resource.data;
      return
        // O e-mail vem do login e não pode ser inventado — diferente do nome.
        d.get('driverEmail', '') == email()
        && d.get('truckId', '') is string
        && d.truckId.size() > 0 && d.truckId.size() < 64
        && d.get('liters', '') is string
        && d.liters.size() > 0 && d.liters.size() < 12
        && d.get('fuelDate', '') is string
        && d.fuelDate.size() <= 10
        // Documento gordo demais é sinal de que não veio do app.
        && d.keys().size() <= 25
        && (!('photoUrls' in d) || (d.photoUrls is list && d.photoUrls.size() <= 5));
    }

    match /fuelRecords/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (isDriver() && validFuelRecord());
      allow update, delete: if isAdmin();
    }

    // ───────── manutenção, peças e histórico ─────────
    // Nada disso aparece para o motorista no app.
    match /maintenance/{docId} {
      allow read, write: if isAdmin();
    }

    match /parts/{docId} {
      allow read, write: if isAdmin();
    }

    match /partsHistory/{docId} {
      allow read, write: if isAdmin();
    }

    // ───────── contadores ─────────
    // Hoje guarda só o próximo número de ordem de serviço
    // (counters/workOrders). Quem cria manutenção precisa incrementar.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ───────── tudo o mais é proibido ─────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
